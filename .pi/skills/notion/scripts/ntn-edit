#!/usr/bin/env python3
"""Edit a Notion page using search-and-replace (markdown).

Usage:
  ntn-edit <page_id_or_url> --old <text> --new <text> [--replace-all]
  ntn-edit <page_id_or_url> --ops <json_file>   # batch: [{old, new}, ...]

Output: JSON with id, truncated, changes count.
"""
import argparse
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from ntn_resolve import ntn_api, extract_id_from_url


class JsonArgParser(argparse.ArgumentParser):
    def error(self, message):
        print(json.dumps({"error": message}), file=sys.stderr)
        sys.exit(1)


def resolve_page_id(target):
    """Resolve URL/ID to a page ID."""
    if target.startswith("http"):
        raw_id, _ = extract_id_from_url(target)
    else:
        raw_id = target.replace("-", "").lower()

    if not raw_id:
        return None

    page = ntn_api(f"v1/pages/{raw_id}", silent=True)
    if page is not None:
        return page["id"].replace("-", "")
    return None


def edit_page(page_id, content_updates):
    """Execute update_content on a page."""
    body = {
        "type": "update_content",
        "update_content": {
            "content_updates": content_updates,
        }
    }
    data = ntn_api(f"v1/pages/{page_id}/markdown", "-X", "PATCH",
                   "--data", json.dumps(body))
    return {
        "id": data.get("id", ""),
        "truncated": data.get("truncated", False),
        "changes": len(content_updates),
    }


def main():
    parser = JsonArgParser(description="Edit Notion page via search-and-replace")
    parser.add_argument("target", help="Page ID or URL")
    parser.add_argument("--old", help="Text to find")
    parser.add_argument("--new", help="Replacement text")
    parser.add_argument("--replace-all", action="store_true",
                        help="Replace all matches (not just first)")
    parser.add_argument("--ops", help="JSON file with batch operations [{old, new}, ...]")
    args = parser.parse_args()

    page_id = resolve_page_id(args.target)
    if not page_id:
        print(json.dumps({"error": f"Could not resolve page from: {args.target}"}),
              file=sys.stderr)
        sys.exit(1)

    if args.ops:
        with open(args.ops, "r") as f:
            ops = json.load(f)
        if len(ops) > 100:
            print(json.dumps({"error": f"Too many operations: {len(ops)} (max 100)"}),
                  file=sys.stderr)
            sys.exit(1)
        content_updates = []
        for op in ops:
            cu = {"old_str": op["old"], "new_str": op["new"]}
            if op.get("replace_all"):
                cu["replace_all_matches"] = True
            content_updates.append(cu)
    elif args.old is not None and args.new is not None:
        cu = {"old_str": args.old, "new_str": args.new}
        if args.replace_all:
            cu["replace_all_matches"] = True
        content_updates = [cu]
    else:
        print(json.dumps({"error": "Provide --old and --new, or --ops <json_file>"}),
              file=sys.stderr)
        sys.exit(1)

    result = edit_page(page_id, content_updates)
    print(json.dumps(result, indent=2, ensure_ascii=False))


if __name__ == "__main__":
    main()
