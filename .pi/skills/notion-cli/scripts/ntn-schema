#!/usr/bin/env python3
"""Show data_source property schema.

Usage:
  ntn-schema <data_source_id_or_url> [--all]

Output: JSON with id, title, properties.
"""
import argparse
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from ntn_resolve import ntn_api, extract_id_from_url


class JsonArgParser(argparse.ArgumentParser):
    def error(self, message):
        print(json.dumps({"error": message}), file=sys.stderr)
        sys.exit(1)


def resolve_data_source_id(target):
    """Given an ID or URL, resolve to data_source ID."""
    if target.startswith("http"):
        raw_id, _ = extract_id_from_url(target)
    else:
        raw_id = target.replace("-", "").lower()

    if not raw_id:
        return None

    data = ntn_api(f"v1/data_sources/{raw_id}", silent=True)
    if data is not None:
        return data

    db = ntn_api(f"v1/databases/{raw_id}", silent=True)
    if db is not None:
        ds_list = db.get("data_sources", [])
        if ds_list:
            return ntn_api(f"v1/data_sources/{ds_list[0]['id'].replace('-', '')}")
    return None


def main():
    parser = JsonArgParser(description="Show data_source schema")
    parser.add_argument("target", help="data_source ID, database ID, or URL")
    parser.add_argument("--all", action="store_true",
                        help="Show full schema (id, description, etc.)")
    args = parser.parse_args()

    data = resolve_data_source_id(args.target)
    if not data:
        print(json.dumps({"error": f"Could not resolve data_source from: {args.target}"}),
              file=sys.stderr)
        sys.exit(1)

    title = ""
    tp = data.get("title", [])
    if tp:
        title = tp[0].get("plain_text", "")

    props = {}
    for name, schema in data.get("properties", {}).items():
        if args.all:
            props[name] = schema
        else:
            entry = {"type": schema.get("type", "")}
            inner = schema.get(schema["type"], {})
            if "options" in inner:
                entry["options"] = [o["name"] for o in inner["options"]]
            if "groups" in inner:
                entry["groups"] = [{"name": g["name"], "options": g.get("option_ids", [])}
                                   for g in inner["groups"]]
            props[name] = entry

    result = {
        "id": data["id"],
        "title": title,
        "properties": props,
    }
    print(json.dumps(result, indent=2, ensure_ascii=False))


if __name__ == "__main__":
    main()
