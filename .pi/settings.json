{
  "packages": [
    "npm:pi-mcp-adapter@2.5.1",
    "npm:@tmustier/pi-tab-status",
    "npm:lsp-pi",
    "git:github.com/MasuRii/pi-tool-display",
    "git:github.com/jwu/pi-powerline",
    "git:github.com/lucasmeijer/pi-terminal-signals",
    "npm:@eko24ive/pi-ask"
  ],
  "lastChangelogVersion": "0.70.6",
  "defaultThinkingLevel": "high",
  "defaultProvider": "deepseek",
  "defaultModel": "deepseek-v4-flash",
  "subagents": {
    "agentOverrides": {
      "context-builder": {
        "model": "deepseek/deepseek-v4-flash",
        "thinking": "high"
      },
      "oracle": {
        "model": "deepseek/deepseek-v4-pro",
        "thinking": "medium"
      },
      "planner": {
        "model": "deepseek/deepseek-v4-pro",
        "thinking": "high",
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "lsp",
          "obsidian_search",
          "obsidian_cli",
          "mcp",
          "subagent"
        ]
      },
      "researcher": {
        "model": "deepseek/deepseek-v4-flash",
        "thinking": "high"
      },
      "reviewer": {
        "model": "deepseek/deepseek-v4-flash",
        "thinking": "high"
      },
      "scout": {
        "model": "deepseek/deepseek-v4-flash",
        "thinking": "minimal"
      },
      "worker": {
        "model": "deepseek/deepseek-v4-flash",
        "thinking": "low"
      }
    }
  }
}
